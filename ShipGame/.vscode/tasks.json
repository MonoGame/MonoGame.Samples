        {
			"label": "Debug WindowsDX12 Build",
			"type": "shell",
			"command": "dotnet build -p:Configuration=Debug ${workspaceFolder}/ShipGame.WindowsDX12/ShipGame.WindowsDX12.csproj",
			"dependsOn": "Build NormalMappingModelProcessor (Release)",
			"dependsOrder": "sequence"
		}
