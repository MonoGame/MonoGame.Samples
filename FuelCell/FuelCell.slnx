<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="x64" />
  </Configurations>
  <Folder Name="/Android/">
    <Project Path="Android/FuelCell.csproj">
      <Deploy />
    </Project>
  </Folder>
  <Folder Name="/Desktop/">
    <Project Path="Desktop/FuelCell.csproj" />
  </Folder>
  <Folder Name="/iOS/">
